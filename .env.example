# ---------------------------------------------------------------------------
# CashflowGuardian local environment template.
# Copy to `.env`, then fill the blank values below top-to-bottom. NEVER commit
# the real `.env`. See README -> "Getting Started" for where each value comes
# from.
# ---------------------------------------------------------------------------

# --- 1. AWS region ------------------------------------------------------------
# Must be the region where you enabled Bedrock model access (§3) and where your
# DynamoDB tables live. boto3 and Strands' BedrockModel both read this.
AWS_REGION=us-east-1

# --- 2. AWS identity ----------------------------------------------------------
# Pick ONE:
#   Option A (recommended) — run `aws configure` or `aws configure sso` once;
#     boto3 then uses ~/.aws automatically. Leave the keys below blank.
#   Option B — static keys: AWS console -> IAM user -> Security credentials ->
#     "Create access key". If you use multiple AWS profiles/accounts instead,
#     leave keys blank and add: AWS_PROFILE=<profile name>.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO/role sessions); otherwise leave blank.
AWS_SESSION_TOKEN=

# --- 3. Amazon Bedrock model --------------------------------------------------
# One model id is used for the Orchestrator and both specialists. You must have
# request access approved in AWS_REGION: Bedrock -> Model access -> request
# Anthropic Claude 3.5 Sonnet. Keep the value once access is enabled.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- 4. Gmail API (OPTIONAL for dry runs; REQUIRED for live sends + scope scan) --
# Google Cloud Console -> your project -> enable "Gmail API" -> Credentials ->
# "Create credentials" -> OAuth client ID -> Application type: Desktop app ->
# Download JSON and save it at GMAIL_CLIENT_SECRET_FILE. Then run the one-time
# consent flow to create the token:  python scripts/gmail_authorize.py
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_TOKEN_FILE=credentials/token.json
# Without the token, live mode logs instead of sending (it never crashes).

# --- 5. PDF output -------------------------------------------------------------
# Where generate_invoice_pdf / generate_change_order_pdf write PDFs. Created
# automatically if missing.
PDF_OUTPUT_DIR=generated

# --- 6. Send mode (local API server / scripts) ---------------------------------
#   live -> approved sends go out through Gmail        (requires the §4 token)
#   log  -> approved sends are logged, never emailed    (safe dry-run fallback;
#           also applied automatically if the Gmail token is missing)
CASHFLOW_SEND_MODE=live

# --- 7. DynamoDB Local (OPTIONAL — local dev only, not an account value) -------
# Uncomment ONLY when running the backend against DynamoDB Local (Docker) per
# README §4a Mode B. Leave commented to use real AWS DynamoDB tables.
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# --- 8. Frontend (separate file) ------------------------------------------------
# Copy frontend/.env.local.example -> frontend/.env.local and set:
#   NEXT_PUBLIC_API_BASE_URL  -> deployed API endpoint from `infra/deploy.sh`
#                                (leave blank in local dev to use LOCAL_API_BASE)
#   LOCAL_API_BASE            -> local serve_api.py address (default :8000)
