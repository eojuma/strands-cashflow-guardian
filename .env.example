# ---------------------------------------------------------------------------
# CashflowGuardian local environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- AWS / Amazon Bedrock (Day 1: foundation) -------------------------------
# Region + model ID used by Strands' BedrockModel (reads the boto3 default
# credential chain, which also honors ~/.aws/credentials and SSO profiles).
# BEDROCK_MODEL_ID must be a model you have Bedrock access enabled for.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Uncomment and fill these ONLY if you are not using ~/.aws/credentials or SSO:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Gmail API (Day 5) ------------------------------------------------------
# Paths to the OAuth files (both gitignored under credentials/):
#   - GMAIL_CLIENT_SECRET_FILE: the downloaded client_secret.json (Desktop app)
#   - GMAIL_TOKEN_FILE: produced by the one-time consent flow on first run
# GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
# GMAIL_TOKEN_FILE=credentials/token.json
