# Copy to frontend/.env.local and adjust.
#
# When set, the dashboard fetches the REST API directly at this absolute URL
# (e.g. the deployed API Gateway endpoint from `infra/deploy.sh` output).
# When unset, /api/* is proxied to LOCAL_API_BASE (default http://localhost:8000)
# during `npm run dev` — the address of a running `python scripts/serve_api.py`.
NEXT_PUBLIC_API_BASE_URL=

# Local dev only — where next.config.js proxies /api/* to.
LOCAL_API_BASE=http://localhost:8000
