{
  "Version": "2012-10-17",
  "Id": "CashflowGuardianLambdaExecutionPolicy",
  "Statement": [
    {
      "Sid": "DynamoDBMemoryAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/CashflowGuardian-Clients",
        "arn:aws:dynamodb:*:*:table/CashflowGuardian-PendingActions",
        "arn:aws:dynamodb:*:*:table/CashflowGuardian-PendingActions/index/ClientIdIndex"
      ]
    },
    {
      "Sid": "BedrockInvokeModel",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:*::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/cashflow-guardian-*"
    }
  ]
}
